PORT=8080
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
MOCK_OPENROUTER=false
# Set the loaded LM Studio model's API identifier to use local AI.
LM_STUDIO_MODEL=
# Direct Go defaults to http://127.0.0.1:1234/v1. Compose defaults to http://host.docker.internal:1234/v1.
LM_STUDIO_BASE_URL=
# Optional. Set this if LM Studio requires API authentication.
LM_STUDIO_API_TOKEN=
# Optional. Compose uses http://tts:8091 and the direct-run server uses http://127.0.0.1:8091.
TTS_BACKEND_URL=
